{
  "openapi": "3.1.0",
  "info": {
    "title": "JobRadar v2.0 API",
    "version": "2.0.0",
    "description": "Enterprise-grade Tech Career Intelligence and Recruitment Automation Platform tailored for Morocco and Global/Remote tech talent.",
    "contact": {
      "name": "Nabil-777",
      "url": "https://github.com/Nabil-777/job-radar"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Platform health and presets"
    },
    {
      "name": "Auth",
      "description": "User authentication and session management"
    },
    {
      "name": "Jobs",
      "description": "Aggregated job search and matching engine"
    },
    {
      "name": "Applications",
      "description": "Kanban application tracking pipeline"
    },
    {
      "name": "Profile",
      "description": "Candidate profile, CV parsing, and structured resume"
    },
    {
      "name": "Providers",
      "description": "Custom RSS/JSON job providers and observability"
    },
    {
      "name": "AI Studio",
      "description": "Cover letter generator and tailored resume studio"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Check API health",
        "description": "Returns current service health, uptime, and database connection state.",
        "responses": {
          "200": {
            "description": "Healthy response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/health/scrapers": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get scraper circuit breaker health",
        "description": "Returns status matrix of all 19+ built-in scrapers with circuit breaker states.",
        "responses": {
          "200": {
            "description": "Scraper health matrix",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScraperHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/presets": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get search domain presets",
        "description": "Returns domain shortcuts (AI, Fullstack, DevOps, Security, Internships).",
        "responses": {
          "200": {
            "description": "Domain presets object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/signup": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Create new user account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSuccessResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "409": {
            "description": "Email already registered"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in with email and password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sign in successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSuccessResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get current authenticated user",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user and linked profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserMeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/auth/demo": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Instant 1-click guest / demo login",
        "responses": {
          "200": {
            "description": "Demo account token and profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log out session",
        "responses": {
          "200": {
            "description": "Logged out successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "Search aggregated jobs with match scores",
        "parameters": [
          {
            "name": "keywords",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Search terms (e.g. React, Python)"
          },
          {
            "name": "location",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Location (e.g. Morocco, Casablanca, Remote)"
          },
          {
            "name": "experienceLevel",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "internship",
                "entry",
                "senior"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "refresh",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "postedAfter",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Filter jobs posted on or after this ISO date or YYYY-MM-DD"
          },
          {
            "name": "postedBefore",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Filter jobs posted on or before this ISO date or YYYY-MM-DD"
          },
          {
            "name": "maxAgeDays",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Filter jobs posted within maximum days (e.g. 7, 30, 90)"
          },
          {
            "name": "dateStatus",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "parsed",
                "unknown",
                "all"
              ]
            },
            "description": "Filter by date resolution status"
          }
        ],
        "responses": {
          "200": {
            "description": "Job listings with AI match scores",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobsSearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/refresh": {
      "post": {
        "tags": [
          "Jobs"
        ],
        "summary": "Force scrape fresh jobs across boards",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "domain": {
                    "type": "string"
                  },
                  "keywords": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scrape refreshed"
          }
        }
      }
    },
    "/api/applications": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "List tracked Kanban applications",
        "responses": {
          "200": {
            "description": "List of applications",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationsListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Applications"
        ],
        "summary": "Add job to Kanban application tracker",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApplicationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Application tracked successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationItem"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/applications/{id}": {
      "patch": {
        "tags": [
          "Applications"
        ],
        "summary": "Update application status or notes",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "Saved",
                      "Applied",
                      "Technical_Test",
                      "Interview",
                      "Offer",
                      "Rejected"
                    ]
                  },
                  "notes": {
                    "type": "string"
                  },
                  "follow_up_at": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application updated"
          },
          "404": {
            "description": "Application not found"
          }
        }
      },
      "delete": {
        "tags": [
          "Applications"
        ],
        "summary": "Delete tracked application",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Application deleted"
          },
          "404": {
            "description": "Application not found"
          }
        }
      }
    },
    "/api/applications/export/csv": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "Export tracked applications as CSV file",
        "responses": {
          "200": {
            "description": "CSV attachment",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/profile": {
      "get": {
        "tags": [
          "Profile"
        ],
        "summary": "Get candidate profile and skills",
        "responses": {
          "200": {
            "description": "Candidate profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Profile"
        ],
        "summary": "Update candidate profile and target skills",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated"
          }
        }
      }
    },
    "/api/profile/upload-cv": {
      "post": {
        "tags": [
          "Profile"
        ],
        "summary": "Upload and parse PDF CV",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "cv": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "CV parsed and structured profile generated"
          },
          "400": {
            "description": "No file uploaded"
          },
          "422": {
            "description": "Scanned PDF without selectable text"
          }
        }
      }
    },
    "/api/providers": {
      "get": {
        "tags": [
          "Providers"
        ],
        "summary": "List custom RSS/JSON providers",
        "responses": {
          "200": {
            "description": "Providers list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvidersListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Providers"
        ],
        "summary": "Add custom RSS or JSON provider",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProviderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Provider created"
          },
          "400": {
            "description": "Invalid provider URL or name"
          }
        }
      }
    },
    "/api/providers/{id}/toggle": {
      "patch": {
        "tags": [
          "Providers"
        ],
        "summary": "Toggle active state of custom provider",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider toggled"
          },
          "404": {
            "description": "Provider not found"
          }
        }
      }
    },
    "/api/providers/{id}": {
      "delete": {
        "tags": [
          "Providers"
        ],
        "summary": "Delete custom provider",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider deleted"
          },
          "404": {
            "description": "Provider not found"
          }
        }
      }
    },
    "/api/providers/health": {
      "get": {
        "tags": [
          "Providers"
        ],
        "summary": "Get live health metrics of all providers",
        "responses": {
          "200": {
            "description": "Provider health metrics summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderHealthSummary"
                }
              }
            }
          }
        }
      }
    },
    "/api/ai/pitch": {
      "post": {
        "tags": [
          "AI Studio"
        ],
        "summary": "Generate 4-in-1 tailored application outreach",
        "description": "Produces personalized Cover Letter, LinkedIn Connection Note, Cold Email, and CV Highlight Tips.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AIPitchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated outreach kit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AIPitchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ai/tailored-cv": {
      "post": {
        "tags": [
          "AI Studio"
        ],
        "summary": "Generate ATS-tailored A4 Resume",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TailoredCvRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured tailored resume and print-ready HTML",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TailoredCvResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "healthy"
          },
          "version": {
            "type": "string",
            "example": "2.0.0"
          },
          "uptime": {
            "type": "number",
            "example": 124.5
          },
          "database": {
            "type": "string",
            "example": "connected"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ScraperHealthResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "matrix": {
            "type": "object"
          }
        }
      },
      "SignupRequest": {
        "type": "object",
        "required": [
          "email",
          "password",
          "fullName"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "dev@jobradar.local"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "example": "SecretPass123!"
          },
          "fullName": {
            "type": "string",
            "example": "Nabil Baghoughi"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "dev@jobradar.local"
          },
          "password": {
            "type": "string",
            "example": "SecretPass123!"
          }
        }
      },
      "AuthSuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsIn..."
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "fullName": {
                "type": "string"
              }
            }
          }
        }
      },
      "UserMeResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "user": {
            "type": "object"
          },
          "profile": {
            "type": "object"
          }
        }
      },
      "JobsSearchResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "jobs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobItem"
            }
          },
          "stats": {
            "type": "object"
          },
          "fromCache": {
            "type": "boolean"
          }
        }
      },
      "JobItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "datePosted": {
            "type": "string"
          },
          "matchScore": {
            "type": "integer",
            "example": 85
          },
          "matchedSkills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missingSkills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateApplicationRequest": {
        "type": "object",
        "required": [
          "company"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Saved",
              "Applied",
              "Technical_Test",
              "Interview",
              "Offer",
              "Rejected"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "ApplicationsListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "applications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApplicationItem"
            }
          }
        }
      },
      "ApplicationItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "profile": {
            "type": "object"
          }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ProvidersListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "CreateProviderRequest": {
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
