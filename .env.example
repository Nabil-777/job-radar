# ==============================================================================
# JobRadar v2.0 Environment Configuration Template
# ==============================================================================

# Server Network Settings
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# ------------------------------------------------------------------------------
# Authentication Security (Required, must be ≥32 characters)
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET=

# ------------------------------------------------------------------------------
# CORS Allowed Origins (Comma-separated, default: http://localhost:4000)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:4000

# ------------------------------------------------------------------------------
# AI Provider Credentials (Optional - deterministic template fallback active)
# JobRadar prioritizes: Gemini > Groq > OpenAI > Local Ollama > Rich Template Engine
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# Instant Alert Webhooks for Radar Background Scanner
# Alerts trigger on matchScore >= 80% or Stage/PFE opportunities
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Cron Schedule for Autonomous Job Sweeps (Standard 5-part cron syntax)
# Default: Every 30 minutes
RADAR_CRON_SCHEDULE="*/30 * * * *"
