# ==============================================================================
# JobRadar v2.0 Environment Configuration
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS (Required / Validated via Zod)
# ------------------------------------------------------------------------------
# PORT: TCP port the application listens on.
# Type: Positive integer | Default: 4000
PORT=4000

# HOST: Network interface binding.
# Type: String | Default: 0.0.0.0 (listen on all network interfaces)
HOST=0.0.0.0

# NODE_ENV: Runtime environment mode.
# Type: Enum ('development' | 'production' | 'test') | Default: development
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (Required / Fails fast if missing)
# ------------------------------------------------------------------------------
# JWT_SECRET: Cryptographic secret key used to sign and verify JSON Web Tokens.
# Type: String (MUST be >= 32 characters in length)
# Generate a secure key in bash via:
#   openssl rand -hex 32
JWT_SECRET=

# CORS_ORIGINS: Comma-separated list of allowed HTTP origin URLs for CORS policy.
# Type: String | Default: http://localhost:4000
# Example: http://localhost:4000,https://jobradar.example.com
CORS_ORIGINS=http://localhost:4000

# ------------------------------------------------------------------------------
# 3. AI PROVIDER API CREDENTIALS (Optional)
# If all keys are omitted or empty, JobRadar gracefully falls back to deterministic
# template generation for Cover Letters, LinkedIn notes, emails, and tailored CVs.
# ------------------------------------------------------------------------------
# Google Gemini API key (generative-ai)
GEMINI_API_KEY=

# Groq Cloud API key (fast inference)
GROQ_API_KEY=

# OpenAI API key (GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=

# Local Ollama endpoint URL (e.g. for mistral, llama3, deepseek)
# Default: http://localhost:11434 (or http://host.docker.internal:11434 in Docker)
OLLAMA_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 4. INSTANT NOTIFICATIONS & WEBHOOKS (Optional)
# Background radar sweeps trigger alerts when a job has match score >= 80% or is a Stage/PFE.
# ------------------------------------------------------------------------------
# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram Destination Chat ID
TELEGRAM_CHAT_ID=

# Discord Webhook URL for posting alert cards
DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 5. BACKGROUND SCHEDULING (Optional)
# ------------------------------------------------------------------------------
# RADAR_CRON_SCHEDULE: Standard 5-field cron expression for autonomous scraping sweeps.
# Type: String (Cron expression) | Default: "0 */2 * * *" (Every 2 hours)
RADAR_CRON_SCHEDULE="0 */2 * * *"
